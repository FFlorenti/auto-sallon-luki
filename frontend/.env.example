# Public settings baked into the frontend at build time. Nothing secret goes here:
# everything prefixed with VITE_ is visible to anyone who opens the website.

# Dealer contact details used by the call / WhatsApp buttons. International format, digits only for WhatsApp.
VITE_DEALER_NAME=Auto Sallon Luki
VITE_DEALER_PHONE=+383 44 000 000
VITE_DEALER_WHATSAPP=38344000000
VITE_DEALER_ADDRESS=Vushtrri, Kosovë

# Cloudflare Turnstile SITE key (public). This one is Cloudflare's test key that always passes.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
