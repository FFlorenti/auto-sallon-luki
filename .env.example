# Copy this file to .env and fill in real values. Never commit .env.
# Used by docker-compose.yml. Generate secrets with e.g.: openssl rand -hex 32

# --- Database ---
POSTGRES_DB=autoluki
POSTGRES_USER=autoluki
POSTGRES_PASSWORD=change-me

# --- API secrets ---
JWT_SIGNING_KEY=change-me-to-at-least-32-random-characters
# First admin account, created on first start if no admin exists yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# --- Cloudflare Turnstile (spam protection) ---
# These are Cloudflare's public TEST keys (always pass). Replace with real keys from the Cloudflare dashboard.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Photo storage: Local (Docker volume), Azure, or Database (photos kept in PostgreSQL) ---
STORAGE_PROVIDER=Local
AZURE_STORAGE_CONNECTION_STRING=

# --- Email notifications for new inquiries (leave SMTP_HOST empty to only log them) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com
NOTIFICATION_EMAIL=

# --- Public dealer details shown on the website ---
DEALER_NAME=Auto Sallon Luki
DEALER_PHONE=+383 44 000 000
DEALER_WHATSAPP=38344000000
DEALER_ADDRESS=Vushtrri, Kosovë

WEB_PORT=8080

# --- Demo / portfolio options ---
# true = show the "demo website" banner and ask search engines not to index the site.
DEMO_MODE=false
# true = serve the API documentation at /swagger outside development.
SWAGGER_ENABLED=false
